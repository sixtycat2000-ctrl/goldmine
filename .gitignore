*.sqlite-wal

# release-build staging + eval scratch
dist/
.evalhome/
eval.sqlite*

# Local execution evidence and archives (commit compact summaries)
# reports/execution itself is a symlink to /Volumes/SSD/goldmine-evidence;
# the bare rule covers the link, the ** rule covers a real directory if it returns.
reports/execution
reports/execution/**
.wrangler/
.taste-skill/

# ZCode session artifacts (build identity shows dirty when present)
.zcode/

# Machine-local environment settings (shared examples remain trackable)
/.env
/.env.local
/.env.*.local
/web/.env
/web/.env.local
/web/.env.*.local
/.dev.vars
/.dev.vars.*
!/.dev.vars.example

# macOS metadata
.DS_Store
._*
