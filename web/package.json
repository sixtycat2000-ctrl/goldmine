{
  "name": "goldmine-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run bake && vite",
    "bake": "python3 ../site/tools/build_learn.py --template learn.template.html --out learn.html",
    "typecheck": "tsc --noEmit",
